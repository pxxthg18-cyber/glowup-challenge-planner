# ============================================================
# GlowUp — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# GlowUp works fully in local-storage Demo Mode if left blank.
# NEVER commit your actual .env file to version control.
# ============================================================

# Supabase Configuration (Optional)
# If not provided, the app runs in local-storage demo mode with
# full functionality — perfect for development and testing.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Only the ANON (public) key should ever be used in the browser.
# NEVER put your service_role key here.
